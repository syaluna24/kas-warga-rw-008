{
  "version": 2,
  "name": "kas-warga-rw-008",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": {
        "outputMode": "standalone"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "DATABASE_URL": "@database_url"
  }
}
